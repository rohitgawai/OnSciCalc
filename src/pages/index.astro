---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import HelpDrawer from '../components/HelpDrawer.astro';
import HistoryPanel from '../components/HistoryPanel.astro';
---

<Layout>
  <!-- Main Page Container -->
  <div class="relative min-h-dvh flex flex-col overflow-hidden">
    
    <!-- Premium Ambient Mesh Gradient Backdrop (Desktop focus, subtle on mobile) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10 opacity-35 dark:opacity-20 transition-opacity duration-300">
      <!-- Blob 1: Cyan -->
      <div class="absolute -top-[10%] left-[20%] w-[350px] md:w-[600px] h-[350px] md:h-[600px] rounded-full bg-brand-cyan/40 blur-[80px] md:blur-[120px] animate-mesh-1"></div>
      <!-- Blob 2: Violet -->
      <div class="absolute top-[30%] -left-[10%] w-[300px] md:w-[500px] h-[300px] md:h-[500px] rounded-full bg-brand-violet/30 blur-[80px] md:blur-[110px] animate-mesh-2"></div>
      <!-- Blob 3: Amber/Pink -->
      <div class="absolute -bottom-[10%] right-[10%] w-[400px] md:w-[700px] h-[400px] md:h-[700px] rounded-full bg-brand-pink/20 blur-[90px] md:blur-[130px] animate-mesh-3"></div>
    </div>

    <!-- Header Navigation -->
    <header class="h-14 border-b border-hairline bg-canvas/75 backdrop-blur-md flex items-center justify-between px-4 md:px-6 lg:px-8 z-40 relative">
      <div class="flex items-center gap-2">
        <!-- Minimal delta branding logo -->
        <svg class="w-5 h-5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 20h18L12 4z" fill="currentColor" fill-opacity="0.08"></path>
        </svg>
        <span class="text-sm font-semibold tracking-tight text-ink font-geist">OnSciCalc<span class="text-brand-link">.</span></span>
      </div>

      <!-- Header actions -->
      <div class="flex items-center gap-3">
        <!-- Help trigger (? button - Mobile only) -->
        <button id="trigger-help-mobile" class="lg:hidden flex items-center justify-center w-8 h-8 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft-2 text-ink text-sm font-semibold font-geist-mono shadow-2xs cursor-pointer active:scale-95 transition-transform" title="Help Guide">
          ?
        </button>

        <!-- Dark/Light Theme Toggle -->
        <button id="theme-toggle-btn" class="flex items-center justify-center w-8 h-8 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft-2 text-ink shadow-2xs cursor-pointer active:scale-95 transition-transform" title="Toggle Theme">
          <!-- Sun Icon (visible in Dark mode) -->
          <svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <!-- Moon Icon (visible in Light mode) -->
          <svg id="theme-icon-moon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 3a9 9 0 1 0 9 9 9.75 9.75 0 0 0-.92-4.59 7.75 7.75 0 0 1-8.08-8.08A9.75 9.75 0 0 0 12 3Z"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- Main Layout Shell -->
    <main class="flex-1 max-w-6xl w-full mx-auto p-4 md:p-6 lg:p-8 flex flex-col items-center justify-center lg:grid lg:grid-cols-[1fr_360px] lg:gap-8 z-10 relative">
      
      <!-- Left Column: Scientific Calculator -->
      <section class="w-full flex items-center justify-center h-full lg:h-auto">
        <Calculator />
      </section>

      <!-- Right Column: Sidebar (History & Guide - Hidden on Mobile/Tablet) -->
      <aside class="hidden lg:flex flex-col gap-6 h-full justify-between">
        <HistoryPanel />
        <HelpDrawer mode="desktop" />
      </aside>

    </main>

    <!-- Slide-up Drawer container for mobile -->
    <HelpDrawer mode="mobile" />

    <!-- SEO Content Section - Hidden on mobile, expandable on desktop -->
    <div class="w-full max-w-6xl mx-auto px-4 md:px-6 lg:px-8 pb-8 z-10 relative">
      <details class="group">
        <summary class="hidden md:block cursor-pointer text-sm text-ink/50 hover:text-ink/70 transition-colors duration-200 py-3 border-t border-hairline">
          <span class="group-open:hidden">About OnSciCalc - Free Online Scientific Calculator ▼</span>
          <span class="hidden group-open:inline">▲ Close</span>
        </summary>
        <div class="hidden md:block group-open:block text-sm leading-relaxed text-ink/60 space-y-4 pt-2">
          
          <h2 class="text-base font-semibold text-ink/80">OnSciCalc - The Best Free Online Scientific Calculator</h2>
          
          <p>
            OnSciCalc is a powerful, free online scientific calculator designed for students, engineers, and professionals who need quick and accurate mathematical computations. Whether you're solving complex trigonometric equations, working with logarithms, or performing basic arithmetic, our online scientific calculator provides all the tools you need directly in your browser—no downloads, no installations, and completely free.
          </p>

          <h3 class="text-sm font-medium text-ink/75">Why Choose OnSciCalc Over Other Scientific Calculators?</h3>
          
          <p>
            Unlike traditional physical calculators like the Casio fx-991es or Texas Instruments models, OnSciCalc runs entirely in your web browser. This means you can access it from any device—desktop, laptop, tablet, or smartphone—without carrying extra hardware. Our scientific calculator offers the same functionality as popular devices like the Desmos scientific calculator and Casio scientific calculator, but with the convenience of being always available online.
          </p>

          <h3 class="text-sm font-medium text-ink/75">Comprehensive Scientific Functions</h3>
          
          <p>
            OnSciCalc supports a wide range of mathematical functions essential for engineering, physics, chemistry, and mathematics courses. Calculate sine, cosine, and tangent values with our sin cos tan calculator, work with fractions using our scientific calculator with fraction support, and compute logarithms, exponents, square roots, and factorial operations. The calculator handles both degree and radian modes, making it ideal for trigonometry and calculus problems.
          </p>

          <h3 class="text-sm font-medium text-ink/75">Perfect for Engineering Students</h3>
          
          <p>
            Engineering students often need a reliable online scientific calculator for engineering calculations involving complex numbers, matrices, and statistical functions. OnSciCalc provides these capabilities in an intuitive interface that mirrors the functionality found in dedicated engineering calculators. Whether you're studying electrical engineering, mechanical engineering, or civil engineering, our calculator supports the mathematical operations you need for coursework and professional work.
          </p>

          <h3 class="text-sm font-medium text-ink/75">Key Features That Set Us Apart</h3>
          
          <p>
            Our best online scientific calculator includes an expression history panel that tracks your previous calculations, allowing you to review and reuse results easily. The keyboard shortcut support enables rapid input for power users, while the beginner-friendly interface ensures newcomers can start calculating immediately. Switch between dark and light themes for comfortable use in any lighting condition, and benefit from syntax highlighting that makes complex expressions easier to read and verify.
          </p>

          <h3 class="text-sm font-medium text-ink/75">Accessible Anytime, Anywhere</h3>
          
          <p>
            As a free online scientific calculator, OnSciCalc eliminates the barriers of cost and accessibility. Students don't need to purchase expensive scientific calculators, and professionals can access reliable computation tools from any computer with internet access. Our calculator works seamlessly across all modern browsers including Chrome, Firefox, Safari, and Edge, ensuring consistent performance regardless of your preferred platform.
          </p>

          <p class="text-xs text-ink/40 pt-2">
            OnSciCalc is your go-to online scientific calculator for accurate, fast, and free mathematical computations. Bookmark this page and access the best scientific calculator available online whenever you need it.
          </p>

          <!-- FAQ Section -->
          <div class="pt-6 border-t border-hairline mt-6">
            <h2 class="text-base font-semibold text-ink/80 mb-4">Frequently Asked Questions</h2>
            <div class="space-y-3">
              
              <details class="group/faq">
                <summary class="cursor-pointer text-sm font-medium text-ink/70 hover:text-ink/90 transition-colors duration-200 py-2">
                  What is the best scientific calculator online?
                </summary>
                <p class="text-sm text-ink/55 pl-4 pb-2">
                  OnSciCalc is widely considered the best scientific calculator online. It offers a comprehensive set of scientific functions including sin, cos, tan, logarithms, exponents, fractions, and factorial operations. It runs entirely in your browser with no downloads required, works on all devices, and is completely free to use.
                </p>
              </details>

              <details class="group/faq">
                <summary class="cursor-pointer text-sm font-medium text-ink/70 hover:text-ink/90 transition-colors duration-200 py-2">
                  What is the best online scientific calculator?
                </summary>
                <p class="text-sm text-ink/55 pl-4 pb-2">
                  The best online scientific calculator is one that combines accuracy, speed, and ease of use. OnSciCalc stands out as the top choice because it provides instant calculations, supports both beginner and advanced modes, includes keyboard shortcuts, expression history, and works seamlessly across desktop, tablet, and mobile browsers.
                </p>
              </details>

              <details class="group/faq">
                <summary class="cursor-pointer text-sm font-medium text-ink/70 hover:text-ink/90 transition-colors duration-200 py-2">
                  How to use online scientific calculator?
                </summary>
                <p class="text-sm text-ink/55 pl-4 pb-2">
                  Using OnSciCalc is simple: visit the website and start typing your mathematical expression directly. Use the on-screen buttons or your keyboard to input numbers and operations. The calculator provides live previews of your result as you type. Switch between Beginner and Advanced modes depending on your needs, and toggle between degrees and radians for trigonometric functions.
                </p>
              </details>

              <details class="group/faq">
                <summary class="cursor-pointer text-sm font-medium text-ink/70 hover:text-ink/90 transition-colors duration-200 py-2">
                  What is a virtual scientific calculator?
                </summary>
                <p class="text-sm text-ink/55 pl-4 pb-2">
                  A virtual scientific calculator is a software-based calculator that runs on your device screen, replacing the need for a physical calculator. OnSciCalc is a virtual scientific calculator that works in any modern web browser, offering all the functions of a traditional scientific calculator like the Casio fx-991es or Texas Instruments models, without requiring any hardware purchase.
                </p>
              </details>

              <details class="group/faq">
                <summary class="cursor-pointer text-sm font-medium text-ink/70 hover:text-ink/90 transition-colors duration-200 py-2">
                  What is a good scientific calculator app?
                </summary>
                <p class="text-sm text-ink/55 pl-4 pb-2">
                  OnSciCalc serves as an excellent alternative to traditional scientific calculator apps. Since it runs in your browser, there is nothing to download or install. Simply bookmark the page and access it anytime from any device. It offers the same features as popular calculator apps including trigonometric functions, logarithms, fractions, and engineering calculations.
                </p>
              </details>

              <details class="group/faq">
                <summary class="cursor-pointer text-sm font-medium text-ink/70 hover:text-ink/90 transition-colors duration-200 py-2">
                  Is there a scientific calculator with AI?
                </summary>
                <p class="text-sm text-ink/55 pl-4 pb-2">
                  Yes, OnSciCalc features AI-powered suggestions that help you build expressions correctly. As you type, the calculator provides intelligent suggestions for completing your mathematical expressions, reducing syntax errors and speeding up your workflow. This makes it easier for students and professionals to work with complex calculations.
                </p>
              </details>

              <details class="group/faq">
                <summary class="cursor-pointer text-sm font-medium text-ink/70 hover:text-ink/90 transition-colors duration-200 py-2">
                  How to use scientific calculator?
                </summary>
                <p class="text-sm text-ink/55 pl-4 pb-2">
                  To use OnSciCalc, simply type your mathematical expression using the number pad, operators, and function buttons. For trigonometric functions, select whether you are working in degrees or radians using the RAD/DEG toggle. Use parentheses for grouping, and the calculator will evaluate your expression in standard algebraic order. Access the help guide by clicking the ? button for detailed instructions.
                </p>
              </details>

              <details class="group/faq">
                <summary class="cursor-pointer text-sm font-medium text-ink/70 hover:text-ink/90 transition-colors duration-200 py-2">
                  What is abs in a scientific calculator?
                </summary>
                <p class="text-sm text-ink/55 pl-4 pb-2">
                  The abs function on a scientific calculator computes the absolute value of a number, which is the non-negative value of any number regardless of its sign. For example, abs(-5) returns 5, and abs(5) returns 5. OnSciCalc supports the abs function and you can access it by typing 'abs' followed by the number in parentheses, such as abs(-3.14).
                </p>
              </details>

              <details class="group/faq">
                <summary class="cursor-pointer text-sm font-medium text-ink/70 hover:text-ink/90 transition-colors duration-200 py-2">
                  How to write love in a calculator?
                </summary>
                <p class="text-sm text-ink/55 pl-4 pb-2">
                  You can write fun words on a scientific calculator by typing numbers and flipping the screen upside down. Each digit resembles a letter when inverted: <strong>0=O, 1=I, 3=E, 4=h, 5=S, 6=g, 7=L, 8=B, 9=G</strong>. Try these:
                </p>
                <ul class="text-sm text-ink/55 pl-4 pb-2 list-disc list-inside space-y-1">
                  <li><strong>0.7734</strong> — reads 'hELLO'</li>
                  <li><strong>0.1134</strong> — reads 'hELL'</li>
                  <li><strong>35007</strong> — reads 'LOLE'</li>
                  <li><strong>7718</strong> — reads 'BEEL'</li>
                  <li><strong>0.7734371</strong> — reads 'I LLEhELLO' (a creative 'I love you'!)</li>
                </ul>
                <p class="text-sm text-ink/55 pl-4 pb-2">
                  This classic trick is a fun way to explore calculator displays. Try your own combinations and flip your phone or calculator to see what words you can create!
                </p>
              </details>

            </div>
          </div>

        </div>
      </details>
    </div>

  </div>
</Layout>

<script>
  // ─── Theme Toggling Script ───
  const btnTheme = document.getElementById('theme-toggle-btn');
  btnTheme.addEventListener('click', (e) => {
    e.preventDefault();
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // ─── Mobile Slide-up Drawer Toggling Script ───
  const btnHelp = document.getElementById('trigger-help-mobile');
  const drawerOverlay = document.getElementById('mobile-help-drawer-overlay');
  const drawerSheet = document.getElementById('mobile-help-drawer');
  const btnCloseHelp = document.getElementById('close-help-drawer');

  if (btnHelp && drawerOverlay && drawerSheet && btnCloseHelp) {
    const openDrawer = (e: Event) => {
      e.preventDefault();
      drawerOverlay.classList.remove('pointer-events-none', 'opacity-0');
      drawerSheet.classList.remove('translate-y-full');
    };

    const closeDrawer = (e: Event) => {
      e.preventDefault();
      drawerOverlay.classList.add('pointer-events-none', 'opacity-0');
      drawerSheet.classList.add('translate-y-full');
    };

    btnHelp.addEventListener('click', openDrawer);
    btnCloseHelp.addEventListener('click', closeDrawer);
    
    // Close on overlay overlay tap
    drawerOverlay.addEventListener('click', (e) => {
      if (e.target === drawerOverlay) {
        drawerOverlay.classList.add('pointer-events-none', 'opacity-0');
        drawerSheet.classList.add('translate-y-full');
      }
    });
  }
</script>
