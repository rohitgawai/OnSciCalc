---
// src/pages/terms-and-conditions.astro
import StaticPage from '../layouts/StaticPage.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const pageUrl = "https://onscicalc.com/terms-and-conditions";

const termsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}/#webpage`,
  "url": pageUrl,
  "name": t('terms.title'),
  "description": t('terms.desc'),
  "inLanguage": lang,
  "isPartOf": {
    "@type": "WebSite",
    "@id": "https://onscicalc.com/#website"
  }
};
---

<StaticPage 
  title={t('terms.title')}
  description={t('terms.desc')}
  canonical={pageUrl}
  breadcrumbs={[{ name: t('nav.terms'), url: '/terms-and-conditions' }]}
  jsonLd={termsSchema}
  lang={lang}
>

  <article class="prose-custom">
    <h1 class="text-2xl md:text-3xl font-bold text-ink font-geist tracking-tight mb-2">{t('nav.terms')}</h1>
    <p class="text-sm text-ink/50 font-geist mb-8">Last updated: July 4, 2026</p>

    <div class="space-y-6 text-sm leading-relaxed text-ink/70 font-geist">

      <section>
        <h2 class="text-lg font-semibold text-ink mb-3">1. Acceptance of Terms</h2>
        <p>
          By accessing and using OnSciCalc (onscicalc.com), you accept and agree to be bound by the terms and provisions of this agreement. If you do not agree to these terms, please do not use our service.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink mb-3">2. Description of Service</h2>
        <p>
          OnSciCalc provides a free online scientific calculator accessible through our website. The calculator supports a wide range of mathematical functions including trigonometry, logarithms, exponents, and basic arithmetic. All computations are performed locally in your web browser.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink mb-3">3. Use License</h2>
        <p>
          Permission is granted to temporarily use OnSciCalc for personal, educational, and non-commercial transitory viewing only.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink mb-3">4. Accuracy of Calculations</h2>
        <p>
          While we strive to provide accurate mathematical computations, OnSciCalc is provided "as is" without warranties of any kind. Calculations are performed using floating-point arithmetic. Users should verify critical calculations independently for high-stakes engineering, scientific, or financial applications.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink mb-3">5. Contact</h2>
        <p>
          If you have questions about these Terms, please contact us via our <a href={translatePath('/contact-us')} class="text-brand-link hover:underline">Contact Us</a> page.
        </p>
      </section>

    </div>
  </article>

</StaticPage>
