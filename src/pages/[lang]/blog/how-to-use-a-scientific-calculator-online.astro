---
// src/pages/[lang]/blog/how-to-use-a-scientific-calculator-online.astro
import StaticPage from '../../../layouts/StaticPage.astro';
import { languages, type SupportedLanguage } from '../../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../../i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as SupportedLanguage[])
    .filter((l) => l !== 'en')
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const pageUrl = `https://onscicalc.com/${lang}/blog/how-to-use-a-scientific-calculator-online`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${pageUrl}/#article`,
  "headline": t('guides.title'),
  "description": t('guides.desc'),
  "url": pageUrl,
  "inLanguage": lang,
  "datePublished": "2026-07-04T00:00:00Z",
  "dateModified": "2026-09-01T00:00:00Z",
  "author": {
    "@type": "Organization",
    "@id": "https://onscicalc.com/#organization"
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://onscicalc.com/#organization"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl
  },
  "image": "https://onscicalc.com/og-image.png",
  "articleSection": "Mathematics & Science"
};
---

<StaticPage
  title={t('guides.title')}
  description={t('guides.desc')}
  canonical={pageUrl}
  ogType="article"
  publishedTime="2026-07-04T00:00:00Z"
  modifiedTime="2026-09-01T00:00:00Z"
  breadcrumbs={[
    { name: t('nav.blog'), url: `/${lang}/blog` },
    { name: t('guides.title'), url: `/${lang}/blog/how-to-use-a-scientific-calculator-online` }
  ]}
  jsonLd={articleSchema}
  lang={lang}
>

  <article class="prose-custom">
    <h1 class="text-2xl md:text-3xl font-bold text-ink font-geist tracking-tight mb-2">{t('guide.calc_guide')}</h1>
    <p class="text-sm text-ink/50 font-geist mb-2">{t('guides.desc')}</p>
    <p class="text-xs text-ink/40 font-geist mb-8">{t('blog.published')}</p>

    <div class="space-y-8 text-sm leading-relaxed text-ink/70 font-geist">

      <section>
        <h2 class="text-lg font-semibold text-ink mb-3">{t('seo.h1')}</h2>
        <p>{t('seo.p1')}</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink mb-3">{t('guide.precedence_title')}</h2>
        <p>{t('guide.precedence_desc')}</p>
        <div class="bg-canvas-soft border border-hairline p-4 rounded-md font-geist-mono text-xs space-y-1 mt-3">
          <div>{t('guide.p1')} <span class="text-ink/50">( ... )</span></div>
          <div>{t('guide.p2')} <span class="text-ink/50">x^y</span></div>
          <div>{t('guide.p3')} <span class="text-ink/50">sin, cos, tan, log, ln</span></div>
          <div>{t('guide.p4')} <span class="text-ink/50">*, /</span></div>
          <div>{t('guide.p5')} <span class="text-ink/50">+, -</span></div>
        </div>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink mb-3">{t('guide.trig_title')}</h2>
        <p>{t('guide.trig_desc')}</p>
        <p class="mt-2 text-xs text-mute font-geist-mono bg-canvas-soft p-2.5 rounded border border-hairline">
          💡 {t('guide.shift_tip')}
        </p>
      </section>

      <section class="border-t border-hairline pt-6">
        <p>
          <a href={translatePath('/')} class="text-brand-link font-medium hover:underline">← {t('nav.calculator')}</a>
        </p>
      </section>

    </div>
  </article>

</StaticPage>
