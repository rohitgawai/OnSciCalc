---
// src/pages/[lang]/contact-us.astro
import StaticPage from '../../layouts/StaticPage.astro';
import { languages, type SupportedLanguage } from '../../i18n/ui';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as SupportedLanguage[])
    .filter((l) => l !== 'en')
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const pageUrl = `https://onscicalc.com/${lang}/contact-us`;

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${pageUrl}/#webpage`,
  "url": pageUrl,
  "name": t('contact.title'),
  "description": t('contact.desc'),
  "inLanguage": lang,
  "isPartOf": {
    "@type": "WebSite",
    "@id": "https://onscicalc.com/#website"
  },
  "mainEntity": {
    "@type": "Organization",
    "@id": "https://onscicalc.com/#organization",
    "email": "contact@onscicalc.com"
  }
};
---

<StaticPage 
  title={t('contact.title')}
  description={t('contact.desc')}
  canonical={pageUrl}
  breadcrumbs={[{ name: t('nav.contact'), url: `/${lang}/contact-us` }]}
  jsonLd={contactPageSchema}
  lang={lang}
>

  <article class="prose-custom">
    <h1 class="text-2xl md:text-3xl font-bold text-ink font-geist tracking-tight mb-2">{t('nav.contact')}</h1>
    <p class="text-sm text-ink/50 font-geist mb-8">{t('brand.tagline')}</p>

    <div class="space-y-8 text-sm leading-relaxed text-ink/70 font-geist">

      <!-- Contact Methods -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Email -->
        <div class="border border-hairline rounded-xl p-5 bg-canvas hover:bg-canvas-soft transition-colors">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-brand-cyan/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-cyan" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div>
              <h3 class="text-base font-semibold text-ink">{t('nav.email_us')}</h3>
              <p class="text-xs text-ink/50">contact@onscicalc.com</p>
            </div>
          </div>
          <a href="mailto:contact@onscicalc.com" class="text-brand-link hover:underline text-sm no-underline">
            contact@onscicalc.com
          </a>
        </div>

        <!-- Calculator Link -->
        <div class="border border-hairline rounded-xl p-5 bg-canvas hover:bg-canvas-soft transition-colors">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-brand-violet/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-violet" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-base font-semibold text-ink">{t('nav.calculator')}</h3>
              <p class="text-xs text-ink/50">OnSciCalc</p>
            </div>
          </div>
          <a href={translatePath('/')} class="text-brand-link hover:underline text-sm no-underline">
            onscicalc.com
          </a>
        </div>
      </div>

      <section class="pt-4 border-t border-hairline">
        <p>
          <a href={translatePath('/')} class="text-brand-link font-medium hover:underline">← {t('nav.calculator')}</a>
        </p>
      </section>

    </div>
  </article>

</StaticPage>
