---
import StaticPage from '../layouts/StaticPage.astro';
---

<StaticPage 
  title="404 - Page Not Found - OnSciCalc"
  description="The page you're looking for doesn't exist. Head back to OnSciCalc to use our free online scientific calculator."
  canonical="https://onscicalc.com/404"
>

  <article class="prose-custom flex flex-col items-center justify-center text-center py-16">
    <h1 class="text-6xl md:text-7xl font-bold text-ink/10 font-geist tracking-tight mb-4">404</h1>
    <h2 class="text-2xl md:text-3xl font-bold text-ink font-geist tracking-tight mb-2">Page Not Found</h2>
    <p class="text-sm text-ink/50 font-geist mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-ink text-canvas text-sm font-semibold font-geist hover:bg-ink/90 transition-colors no-underline">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M3 12h18M3 12l6-6M3 12l6 6"></path>
      </svg>
      Back to Calculator
    </a>
  </article>

</StaticPage>
