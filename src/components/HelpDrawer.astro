---
// src/components/HelpDrawer.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  mode?: 'mobile' | 'desktop' | 'all';
  lang?: SupportedLanguage;
}

const detectedLang = getLangFromUrl(Astro.url);
const { mode = 'all', lang = detectedLang } = Astro.props;
const t = useTranslations(lang);
---

{ (mode === 'all' || mode === 'mobile') && (
  <div id="mobile-help-drawer-overlay" class="fixed inset-0 bg-[#000000]/40 backdrop-blur-xs z-50 transition-opacity duration-300 opacity-0 pointer-events-none lg:hidden">
    <div id="mobile-help-drawer" class="absolute bottom-0 left-0 right-0 bg-canvas rounded-t-xl border-t border-hairline p-6 max-h-[80vh] overflow-y-auto transform translate-y-full transition-transform duration-300 ease-out flex flex-col gap-4 shadow-2xl">
      <div class="flex items-center justify-between border-b border-hairline pb-3">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-brand-cyan"></span>
          <h3 class="text-sm font-semibold tracking-tight uppercase font-geist-mono text-body">{t('guide.calc_guide')}</h3>
        </div>
        <button id="close-help-drawer" class="text-mute hover:text-ink text-sm p-1 cursor-pointer font-geist-mono">
          {t('guide.close')}
        </button>
      </div>
      
      <div class="flex flex-col gap-5 text-sm overflow-y-auto">
        <div class="flex flex-col gap-1.5">
          <h4 class="font-medium text-ink">{t('guide.precedence_title')}</h4>
          <p class="text-body text-xs leading-relaxed">
            {t('guide.precedence_desc')}
          </p>
          <div class="p-2.5 bg-canvas-soft border border-hairline rounded-md font-geist-mono text-[10px] text-brand-link flex flex-col gap-1">
            <div>{t('guide.p1')} <span class="text-mute">( ... )</span></div>
            <div>{t('guide.p2')} <span class="text-mute">x^y</span></div>
            <div>{t('guide.p3')} <span class="text-mute">sin, ln</span></div>
            <div>{t('guide.p4')} <span class="text-mute">*, /</span></div>
            <div>{t('guide.p5')} <span class="text-mute">+, -</span></div>
          </div>
        </div>

        <div class="border-t border-hairline my-1"></div>

        <div class="flex flex-col gap-3">
          <h4 class="font-medium text-ink">{t('guide.concepts_title')}</h4>
          
          <div class="flex flex-col gap-3 font-geist-mono text-xs">
            <!-- Exponents -->
            <div class="bg-canvas-soft border border-hairline p-3 rounded-md flex flex-col gap-1">
              <div class="flex justify-between font-semibold text-ink">
                <span>{t('guide.exponent_title')}</span>
                <span class="text-brand-link">2^3</span>
              </div>
              <p class="text-mute text-[10px] leading-normal">{t('guide.exponent_desc')}</p>
            </div>

            <!-- Functions -->
            <div class="bg-canvas-soft border border-hairline p-3 rounded-md flex flex-col gap-1">
              <div class="flex justify-between font-semibold text-ink">
                <span>{t('guide.trig_title')}</span>
                <span class="text-brand-link">sin(30)</span>
              </div>
              <p class="text-mute text-[10px] leading-normal">{t('guide.trig_desc')}</p>
              <p class="text-mute text-[10px] leading-normal border-t border-hairline pt-1 mt-1">
                💡 {t('guide.shift_tip')}
              </p>
            </div>

            <!-- Parentheses -->
            <div class="bg-canvas-soft border border-hairline p-3 rounded-md flex flex-col gap-1">
              <div class="flex justify-between font-semibold text-ink">
                <span>{t('guide.implicit_title')}</span>
                <span class="text-brand-link">(2+3)*4</span>
              </div>
              <p class="text-mute text-[10px] leading-normal">{t('guide.implicit_desc')}</p>
            </div>

            <!-- Logarithms -->
            <div class="bg-canvas-soft border border-hairline p-3 rounded-md flex flex-col gap-1">
              <div class="flex justify-between font-semibold text-ink">
                <span>{t('guide.log_title')}</span>
                <span class="text-brand-link">log(100)</span>
              </div>
              <p class="text-mute text-[10px] leading-normal">{t('guide.log_desc')}</p>
            </div>

            <!-- Factorials -->
            <div class="bg-canvas-soft border border-hairline p-3 rounded-md flex flex-col gap-1">
              <div class="flex justify-between font-semibold text-ink">
                <span>{t('guide.factorial_title')}</span>
                <span class="text-brand-link">4!</span>
              </div>
              <p class="text-mute text-[10px] leading-normal">{t('guide.factorial_desc')}</p>
            </div>
          </div>
        </div>
        
        <div class="bg-canvas-soft-2 border border-hairline rounded-md p-3 text-[11px] leading-normal text-body font-geist-mono">
          <span class="font-semibold text-ink">💡 {t('guide.keyboard_title')}</span> {t('guide.keyboard_desc')}
        </div>
      </div>
    </div>
  </div>
)}

{ (mode === 'all' || mode === 'desktop') && (
  <div class="hidden lg:flex flex-col gap-6 bg-canvas border border-hairline rounded-lg p-6 shadow-sm h-full overflow-y-auto">
    <div class="flex items-center gap-2 border-b border-hairline pb-4">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-brand-cyan"></span>
      <h3 class="text-xs font-semibold tracking-tight uppercase font-geist-mono text-body">{t('guide.title')}</h3>
    </div>

    <div class="flex flex-col gap-4 text-xs">
      <div class="flex flex-col gap-1.5">
        <h4 class="font-medium text-ink text-sm">{t('guide.precedence_title')}</h4>
        <p class="text-body leading-relaxed">
          {t('guide.precedence_desc')}
        </p>
        <div class="p-2.5 bg-canvas-soft border border-hairline rounded-md font-geist-mono text-[10px] text-brand-link flex flex-col gap-1">
          <div>{t('guide.p1')} <span class="text-mute">( ... )</span></div>
          <div>{t('guide.p2')} <span class="text-mute">x^y</span></div>
          <div>{t('guide.p3')} <span class="text-mute">sin, ln</span></div>
          <div>{t('guide.p4')} <span class="text-mute">*, /</span></div>
          <div>{t('guide.p5')} <span class="text-mute">+, -</span></div>
        </div>
      </div>

      <div class="border-t border-hairline my-2"></div>

      <h4 class="font-medium text-ink text-sm">{t('guide.concepts_title')}</h4>
      
      <div class="flex flex-col gap-3 font-geist-mono text-[11px]">
        <!-- Exponent -->
        <div class="bg-canvas-soft border border-hairline p-3 rounded-md flex flex-col gap-1.5">
          <div class="flex justify-between font-semibold text-ink">
            <span>{t('guide.exponent_title')}</span>
            <span class="text-brand-link">5^2</span>
          </div>
          <p class="text-mute text-[10px] leading-normal">{t('guide.exponent_desc')}</p>
        </div>

        <!-- Trigonometry -->
        <div class="bg-canvas-soft border border-hairline p-3 rounded-md flex flex-col gap-1.5">
          <div class="flex justify-between font-semibold text-ink">
            <span>{t('guide.trig_title')}</span>
            <span class="text-brand-link">cos(pi)</span>
          </div>
          <p class="text-mute text-[10px] leading-normal">{t('guide.trig_desc')}</p>
          <p class="text-mute text-[10px] leading-normal border-t border-hairline pt-1 mt-1">
            💡 {t('guide.shift_tip')}
          </p>
        </div>

        <!-- Parentheses -->
        <div class="bg-canvas-soft border border-hairline p-3 rounded-md flex flex-col gap-1.5">
          <div class="flex justify-between font-semibold text-ink">
            <span>{t('guide.implicit_title')}</span>
            <span class="text-brand-link">3(4+2)</span>
          </div>
          <p class="text-mute text-[10px] leading-normal">{t('guide.implicit_desc')}</p>
        </div>

        <!-- Logarithms -->
        <div class="bg-canvas-soft border border-hairline p-3 rounded-md flex flex-col gap-1.5">
          <div class="flex justify-between font-semibold text-ink">
            <span>{t('guide.log_title')}</span>
            <span class="text-brand-link">ln(e)</span>
          </div>
          <p class="text-mute text-[10px] leading-normal">{t('guide.log_desc')}</p>
        </div>
      </div>
    </div>

    <div class="mt-auto pt-4 border-t border-hairline bg-canvas-soft-2 rounded-md p-3 text-[11px] leading-normal text-body font-geist-mono">
      <span class="font-bold text-ink">{t('guide.keyboard_title')}</span><br/>
      {t('guide.keyboard_desc')}
    </div>
  </div>
)}
