---
// src/components/Calculator.astro
---

<div class="w-full max-w-[540px] bg-canvas border border-hairline rounded-xl shadow-lg overflow-hidden flex flex-col h-full lg:h-auto">
  <!-- Calculator Display Screen -->
  <div class="bg-canvas-soft-2 p-5 border-b border-hairline flex flex-col gap-2 relative">
    <!-- Mode status line -->
    <div class="flex justify-between items-center text-[10px] font-geist-mono uppercase tracking-wider text-mute">
      <div class="flex gap-3">
        <span id="indicator-angle" class="font-bold text-brand-link">RAD</span>
        <span id="indicator-mode" class="font-bold">Advanced</span>
      </div>
      <div id="indicator-status" class="flex items-center gap-1.5 text-brand-success">
        <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
        Ready
      </div>
    </div>

    <!-- Multi-line display screen -->
    <div class="flex flex-col items-end justify-end select-text min-h-[92px] gap-1 font-geist-mono">
      <!-- Top line: History or context -->
      <div id="screen-history" class="text-xs text-mute h-5 overflow-hidden text-right whitespace-nowrap w-full truncate"></div>
      
      <!-- Middle line: Current active expression -->
      <div class="w-full flex items-center justify-end overflow-x-auto no-scrollbar scroll-smooth">
        <div id="screen-input" class="text-2xl font-semibold text-ink tracking-tight whitespace-nowrap text-right min-h-[36px] flex items-center justify-end gap-0.5">
          <!-- Text and custom blinking cursor -->
          <span id="expression-text"></span><span class="caret-blink text-brand-link font-normal">|</span>
        </div>
      </div>

      <!-- Bottom line: Live preview or suggestions -->
      <div id="screen-output" class="text-sm font-medium text-brand-link h-5 select-all overflow-hidden text-right whitespace-nowrap w-full truncate"></div>
    </div>
  </div>

  <!-- AI / Contextual Suggestion Strip -->
  <div class="bg-canvas border-b border-hairline px-4 py-2 flex items-center gap-2 min-h-[44px]">
    <span class="text-[10px] font-geist-mono uppercase text-mute whitespace-nowrap">AI Suggestions:</span>
    <div id="suggestions-container" class="flex gap-2 overflow-x-auto no-scrollbar w-full py-0.5 scroll-smooth">
      <span class="text-xs text-mute font-geist-mono italic">Start typing to see suggestions...</span>
    </div>
  </div>

  <!-- Calculator Controls & Keyboard Selection -->
  <div class="flex items-center justify-between border-b border-hairline px-5 py-2 bg-canvas-soft">
    <!-- Mode selector pill -->
    <div class="bg-canvas border border-hairline rounded-full p-0.5 flex">
      <button id="btn-mode-beginner" class="px-3 py-1 text-xs rounded-full font-medium cursor-pointer transition-all duration-150 bg-ink text-canvas shadow-xs">Beginner</button>
      <button id="btn-mode-advanced" class="px-3 py-1 text-xs rounded-full font-medium cursor-pointer transition-all duration-150 text-body hover:text-ink">Advanced</button>
    </div>

    <!-- Trig Angle & Second toggles -->
    <div class="flex gap-2 items-center">
      <!-- 2nd Shift selector pill -->
      <div id="second-toggle-container" class="bg-canvas border border-hairline rounded-full p-0.5 flex hidden">
        <button id="btn-second" class="px-3 py-0.5 text-[10px] font-bold rounded-full cursor-pointer transition-all duration-150 text-body hover:text-ink">2nd</button>
      </div>

      <!-- Trig Angle selector pill -->
      <div id="angle-toggle-container" class="bg-canvas border border-hairline rounded-full p-0.5 flex">
        <button id="btn-angle-deg" class="px-3 py-0.5 text-[10px] font-bold rounded-full cursor-pointer transition-all duration-150 text-body hover:text-ink">DEG</button>
        <button id="btn-angle-rad" class="px-3 py-0.5 text-[10px] font-bold rounded-full cursor-pointer transition-all duration-150 bg-ink text-canvas shadow-xs">RAD</button>
      </div>
    </div>
  </div>

  <!-- Keyboard grids container -->
  <div class="flex-1 bg-canvas p-4 select-none flex flex-col justify-end">
    <!-- Beginner Keypad Grid (4 columns) -->
    <div id="keypad-beginner" class="grid grid-cols-4 gap-2.5 w-full">
      <button class="key-control bg-canvas-soft-2 text-brand-error border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist-mono text-sm font-semibold cursor-pointer" data-val="AC">AC</button>
      <button class="key-control bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist-mono text-sm font-semibold cursor-pointer" data-val="DEL">DEL</button>
      <button class="key-val bg-canvas-soft-2 text-brand-link border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist-mono text-sm font-semibold cursor-pointer" data-val="(">(</button>
      <button class="key-val bg-canvas-soft-2 text-brand-link border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist-mono text-sm font-semibold cursor-pointer" data-val=")">)</button>

      <!-- Numbers and Basic Operators -->
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist text-base font-medium cursor-pointer" data-val="7">7</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist text-base font-medium cursor-pointer" data-val="8">8</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist text-base font-medium cursor-pointer" data-val="9">9</button>
      <button class="key-val bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist-mono text-base font-bold cursor-pointer" data-val="÷">÷</button>

      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist text-base font-medium cursor-pointer" data-val="4">4</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist text-base font-medium cursor-pointer" data-val="5">5</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist text-base font-medium cursor-pointer" data-val="6">6</button>
      <button class="key-val bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist-mono text-base font-bold cursor-pointer" data-val="×">×</button>

      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist text-base font-medium cursor-pointer" data-val="1">1</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist text-base font-medium cursor-pointer" data-val="2">2</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist text-base font-medium cursor-pointer" data-val="3">3</button>
      <button class="key-val bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist-mono text-base font-bold cursor-pointer" data-val="-">-</button>

      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist text-base font-medium cursor-pointer" data-val="0">0</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-4 rounded-md font-geist text-base font-medium cursor-pointer" data-val=".">.</button>
      <button id="btn-equals-beginner" class="key-control col-span-2 bg-ink text-canvas hover:bg-[#2c2c2c] dark:bg-canvas dark:text-ink dark:hover:bg-[#e1e1e1] py-4 rounded-md font-geist text-base font-semibold cursor-pointer shadow-sm transition-colors text-center" data-val="=">=</button>
    </div>

    <!-- Advanced Scientific Keypad Grid (5 columns, initially visible) -->
    <div id="keypad-advanced" class="grid grid-cols-5 gap-2 w-full hidden">
      <!-- Scientific Functions -->
      <button id="btn-trig-sin" class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="sin(">sin</button>
      <button id="btn-trig-cos" class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="cos(">cos</button>
      <button id="btn-trig-tan" class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="tan(">tan</button>
      <button class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="^">x^y</button>
      <button id="btn-fn-sqrt" class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="√(">√</button>

      <button id="btn-fn-ln" class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="ln(">ln</button>
      <button id="btn-fn-log" class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="log(">log</button>
      <button class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="π">π</button>
      <button class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="e">e</button>
      <button class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="!">!</button>

      <!-- Standard keys layout inside Advanced -->
      <button class="key-control bg-canvas-soft-2 text-brand-error border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist-mono text-xs font-bold cursor-pointer" data-val="AC">AC</button>
      <button class="key-control bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist-mono text-xs font-bold cursor-pointer" data-val="DEL">DEL</button>
      <button class="key-val bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist-mono text-xs font-bold cursor-pointer" data-val="(">(</button>
      <button class="key-val bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist-mono text-xs font-bold cursor-pointer" data-val=")">)</button>
      <button class="key-val bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist-mono text-xs font-bold cursor-pointer" data-val="mod">mod</button>

      <!-- Numbers & basic operators -->
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer" data-val="7">7</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer" data-val="8">8</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer" data-val="9">9</button>
      <button class="key-val bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist-mono text-sm font-bold cursor-pointer" data-val="÷">÷</button>
      <button id="btn-fn-sq" class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="^2">x²</button>

      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer" data-val="4">4</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer" data-val="5">5</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer" data-val="6">6</button>
      <button class="key-val bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist-mono text-sm font-bold cursor-pointer" data-val="×">×</button>
      <button class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="10^(">10^x</button>

      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer" data-val="1">1</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer" data-val="2">2</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer" data-val="3">3</button>
      <button class="key-val bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist-mono text-sm font-bold cursor-pointer" data-val="-">-</button>
      <button class="key-val bg-canvas-soft text-body border border-hairline hover:bg-canvas-soft-2 transition-colors py-3.5 rounded-md font-geist-mono text-xs font-semibold cursor-pointer" data-val="abs(">abs</button>

      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer" data-val="0">0</button>
      <button class="key-val bg-canvas border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer" data-val=".">.</button>
      <button id="btn-equals-advanced" class="key-control col-span-2 bg-ink text-canvas hover:bg-[#2c2c2c] dark:bg-canvas dark:text-ink dark:hover:bg-[#e1e1e1] py-3.5 rounded-md font-geist text-base font-semibold cursor-pointer transition-colors shadow-sm text-center" data-val="=">=</button>
      <button class="key-val bg-canvas-soft-2 text-ink border border-hairline hover:bg-canvas-soft transition-colors py-3.5 rounded-md font-geist-mono text-sm font-bold cursor-pointer" data-val="+">+</button>
    </div>
  </div>
</div>

<script>
  // ─── Mathematical Parser Engine ───
  class MathParser {
    constructor(angleMode = 'RAD') {
      this.angleMode = angleMode;
    }

    tokenize(str) {
      // Map display symbols to parsable tokens
      let prepared = str
        .replace(/×/g, '*')
        .replace(/÷/g, '/')
        .replace(/π/g, 'pi')
        .replace(/√\(/g, 'sqrt(')
        .replace(/∛\(/g, 'cbrt(')
        .replace(/e\^\(/g, 'exp(')
        .replace(/sin⁻¹\(/g, 'asin(')
        .replace(/cos⁻¹\(/g, 'acos(')
        .replace(/tan⁻¹\(/g, 'atan(');
      
      const regex = /\d+(\.\d+)?|asin|acos|atan|sin|cos|tan|ln|log|abs|sqrt|cbrt|exp|mod|pi|[e+*/^!()\-]/g;
      let tokens = prepared.match(regex) || [];
      return tokens;
    }

    insertImplicitMultiplication(tokens) {
      const result = [];
      for (let i = 0; i < tokens.length; i++) {
        result.push(tokens[i]);
        if (i < tokens.length - 1) {
          const curr = tokens[i];
          const next = tokens[i + 1];
          
          const currIsNum = /^\d+(\.\d+)?$/.test(curr);
          const currIsConst = ['pi', 'e'].includes(curr);
          const currIsParenClose = curr === ')';
          const currIsFactorial = curr === '!';
          
          const nextIsNum = /^\d+(\.\d+)?$/.test(next);
          const nextIsConst = ['pi', 'e'].includes(next);
          const nextIsFunc = ['sin', 'cos', 'tan', 'ln', 'log', 'sqrt', 'cbrt', 'abs', 'exp', 'asin', 'acos', 'atan'].includes(next);
          const nextIsParenOpen = next === '(';
          
          if (
            (currIsNum && (nextIsConst || nextIsFunc || nextIsParenOpen)) ||
            (currIsConst && (nextIsNum || nextIsConst || nextIsFunc || nextIsParenOpen)) ||
            (currIsParenClose && (nextIsNum || nextIsConst || nextIsFunc || nextIsParenOpen)) ||
            (currIsFactorial && (nextIsNum || nextIsConst || nextIsFunc || nextIsParenOpen))
          ) {
            result.push('*');
          }
        }
      }
      return result;
    }

    parse(tokens) {
      let position = 0;

      const peek = () => tokens[position];
      const consume = (expected) => {
        if (peek() === expected) {
          position++;
          return true;
        }
        return false;
      };

      // Factorial calculations (Unary right-associative operator)
      const factorial = (n) => {
        if (n < 0 || !Number.isInteger(n)) return NaN;
        if (n === 0 || n === 1) return 1;
        let r = 1;
        for (let i = 2; i <= n; i++) r *= i;
        return r;
      };

      // Expression = Term (( "+" | "-" ) Term)*
      const parseExpression = () => {
        let value = parseTerm();
        while (true) {
          if (consume('+')) {
            value += parseTerm();
          } else if (consume('-')) {
            value -= parseTerm();
          } else {
            break;
          }
        }
        return value;
      };

      // Term = Unary (( "*" | "/" | "mod" ) Unary)*
      const parseTerm = () => {
        let value = parseUnary();
        while (true) {
          if (consume('*')) {
            value *= parseUnary();
          } else if (consume('/')) {
            let divisor = parseUnary();
            if (divisor === 0) throw new Error("Division by zero");
            value /= divisor;
          } else if (consume('mod')) {
            value %= parseUnary();
          } else {
            break;
          }
        }
        return value;
      };

      // Unary = ( "+" | "-" ) Unary | parseExponent
      const parseUnary = () => {
        if (consume('-')) {
          return -parseUnary();
        }
        consume('+'); // Ignore unary plus
        return parseExponent();
      };

      // Exponent = Factor ( "^" parseUnary )?
      const parseExponent = () => {
        let value = parseFactor();
        if (consume('^')) {
          value = Math.pow(value, parseUnary());
        }
        return value;
      };

      // Factor = parsePrimary "!"*
      const parseFactor = () => {
        let value = parsePrimary();
        while (consume('!')) {
          value = factorial(value);
        }
        return value;
      };

      // Primary = Number | Constant | Function | "(" parseExpression ")"
      const parsePrimary = () => {
        let token = peek();
        if (!token) return 0; // Empty fallback

        // Parentheses matching
        if (consume('(')) {
          let value = parseExpression();
          consume(')'); // Consume closing paren if present, ignore if unmatched for flexibility
          return value;
        }

        // Functions
        if (['sin', 'cos', 'tan', 'ln', 'log', 'sqrt', 'cbrt', 'abs', 'exp', 'asin', 'acos', 'atan'].includes(token)) {
          position++;
          consume('('); // Consume standard opening paren
          let arg = parseExpression();
          consume(')');
          
          if (token === 'sin') {
            let rad = this.angleMode === 'DEG' ? (arg * Math.PI / 180) : arg;
            let val = Math.sin(rad);
            return Math.abs(val) < 1e-15 ? 0 : val;
          }
          if (token === 'cos') {
            let rad = this.angleMode === 'DEG' ? (arg * Math.PI / 180) : arg;
            let val = Math.cos(rad);
            return Math.abs(val) < 1e-15 ? 0 : val;
          }
          if (token === 'tan') {
            let rad = this.angleMode === 'DEG' ? (arg * Math.PI / 180) : arg;
            if (Math.abs(Math.cos(rad)) < 1e-15) {
              throw new Error("Tangent undefined");
            }
            let val = Math.tan(rad);
            return Math.abs(val) < 1e-15 ? 0 : val;
          }
          if (token === 'asin') {
            if (arg < -1 || arg > 1) throw new Error("asin domain: [-1, 1]");
            let val = Math.asin(arg);
            let result = this.angleMode === 'DEG' ? (val * 180 / Math.PI) : val;
            return Math.abs(result) < 1e-15 ? 0 : result;
          }
          if (token === 'acos') {
            if (arg < -1 || arg > 1) throw new Error("acos domain: [-1, 1]");
            let val = Math.acos(arg);
            let result = this.angleMode === 'DEG' ? (val * 180 / Math.PI) : val;
            return Math.abs(result) < 1e-15 ? 0 : result;
          }
          if (token === 'atan') {
            let val = Math.atan(arg);
            let result = this.angleMode === 'DEG' ? (val * 180 / Math.PI) : val;
            return Math.abs(result) < 1e-15 ? 0 : result;
          }
          if (token === 'ln') {
            if (arg <= 0) throw new Error("Invalid ln argument");
            return Math.log(arg);
          }
          if (token === 'log') {
            if (arg <= 0) throw new Error("Invalid log argument");
            return Math.log10(arg);
          }
          if (token === 'sqrt') {
            if (arg < 0) throw new Error("Negative square root");
            return Math.sqrt(arg);
          }
          if (token === 'cbrt') {
            return Math.cbrt(arg);
          }
          if (token === 'exp') {
            return Math.exp(arg);
          }
          if (token === 'abs') return Math.abs(arg);
        }

        // Constants
        if (consume('pi')) return Math.PI;
        if (consume('e')) return Math.E;

        // Parse numbers
        if (/^\d+(\.\d+)?$/.test(token)) {
          position++;
          return parseFloat(token);
        }

        // Unknown token error prevention
        position++;
        return 0;
      };

      try {
        let result = parseExpression();
        if (position < tokens.length) {
          throw new Error("Syntax Error");
        }
        if (isNaN(result)) throw new Error("Invalid mathematical operation");
        return result;
      } catch (err) {
        throw err;
      }
    }

    calculate(str) {
      if (!str.trim()) return "";
      
      // Auto close open parentheses before parsing
      let balance = 0;
      for (let char of str) {
        if (char === '(') balance++;
        if (char === ')') balance--;
      }
      let balancedStr = str;
      while (balance > 0) {
        balancedStr += ')';
        balance--;
      }

      let tokens = this.tokenize(balancedStr);
      if (tokens.length === 0) return "";
      tokens = this.insertImplicitMultiplication(tokens);
      return this.parse(tokens);
    }
  }

  // ─── Calculator App State ───
  let state = {
    expression: "",
    angleMode: "RAD",
    layoutMode: "BEGINNER", // or ADVANCED
    secondActive: false,
  };

  const parser = new MathParser(state.angleMode);

  // Load from local storage if exists
  if (typeof localStorage !== 'undefined') {
    state.angleMode = localStorage.getItem('angleMode') || 'RAD';
    state.layoutMode = localStorage.getItem('layoutMode') || 'BEGINNER';
  }

  // DOM Elements
  const elText = document.getElementById('expression-text');
  const elHistory = document.getElementById('screen-history');
  const elOutput = document.getElementById('screen-output');
  const elSuggestions = document.getElementById('suggestions-container');
  const elAngleIndicator = document.getElementById('indicator-angle');
  const elModeIndicator = document.getElementById('indicator-mode');
  
  // Controls
  const btnBeg = document.getElementById('btn-mode-beginner');
  const btnAdv = document.getElementById('btn-mode-advanced');
  const btnDeg = document.getElementById('btn-angle-deg');
  const btnRad = document.getElementById('btn-angle-rad');

  const keypadBeg = document.getElementById('keypad-beginner');
  const keypadAdv = document.getElementById('keypad-advanced');

  // ─── Calculator Actions ───

  // 1. pushToCalculationHistory (no dependencies)
  function pushToCalculationHistory(expr, res) {
    let history = JSON.parse(localStorage.getItem('calc_history') || '[]');
    history.unshift({ expr, res, time: Date.now() });
    // Cap history at 50 items
    if (history.length > 50) history.pop();
    localStorage.setItem('calc_history', JSON.stringify(history));

    // Custom event to sync HistoryPanel
    window.dispatchEvent(new CustomEvent('historyUpdated'));
  }

  // 2. evaluateLive (depends on parser)
  function evaluateLive() {
    if (!state.expression.trim()) {
      elOutput.textContent = "";
      return;
    }
    try {
      const result = parser.calculate(state.expression);
      if (result === "") {
        elOutput.textContent = "";
      } else {
        // Format result cleanly
        if (typeof result === 'number') {
          if (isNaN(result)) {
            elOutput.textContent = "Error: Invalid operation";
          } else if (!isFinite(result)) {
            elOutput.textContent = "Infinity";
          } else {
            // Trim floating points cleanly
            let strRes = Number(result.toFixed(10)).toString();
            elOutput.textContent = strRes;
          }
        } else {
          elOutput.textContent = result;
        }
      }
    } catch (e) {
      elOutput.textContent = e.message;
    }
  }

  // 3. performCalculation (depends on evaluateLive, pushToCalculationHistory, updateScreen)
  function performCalculation() {
    const expr = state.expression.trim();
    if (!expr) return;
    try {
      const result = parser.calculate(expr);
      if (result !== "") {
        let strRes = "";
        if (typeof result === 'number') {
          if (isNaN(result)) {
            strRes = "Error";
          } else if (!isFinite(result)) {
            strRes = "Infinity";
          } else {
            strRes = Number(result.toFixed(10)).toString();
          }
        } else {
          strRes = result.toString();
        }

        // Add to history UI
        elHistory.textContent = `${expr} =`;
        
        // Push to local storage history list
        pushToCalculationHistory(expr, strRes);

        // Update display to final answer
        state.expression = strRes;
        updateScreen();
        elOutput.textContent = ""; // Clear preview since it became primary
      }
    } catch (e) {
      elOutput.textContent = e.message;
    }
  }

  // 4. generateSuggestions (depends on performCalculation, updateScreen)
  function generateSuggestions() {
    const expr = state.expression;
    elSuggestions.innerHTML = "";

    if (!expr.trim()) {
      elSuggestions.innerHTML = `<span class="text-xs text-mute font-geist-mono italic">Start typing to see suggestions...</span>`;
      return;
    }

    const suggestions = [];

    // Helper to add suggestion
    const addSuggestion = (label, insertionText, replacement = false) => {
      suggestions.push({ label, insertionText, replacement });
    };

    // 1. Parentheses balance check
    let openCount = 0;
    for (let char of expr) {
      if (char === '(') openCount++;
      if (char === ')') openCount--;
    }
    if (openCount > 0) {
      addSuggestion(`Close parenthesis )`, ')');
    }

    // 2. Trigonometric / log function auto brackets
    const incompleteFunctions = [
      { trigger: /sin$/, replacement: 'sin(' },
      { trigger: /cos$/, replacement: 'cos(' },
      { trigger: /tan$/, replacement: 'tan(' },
      { trigger: /asin$/, replacement: 'asin(' },
      { trigger: /acos$/, replacement: 'acos(' },
      { trigger: /atan$/, replacement: 'atan(' },
      { trigger: /sin⁻¹$/, replacement: 'sin⁻¹(' },
      { trigger: /cos⁻¹$/, replacement: 'cos⁻¹(' },
      { trigger: /tan⁻¹$/, replacement: 'tan⁻¹(' },
      { trigger: /log$/, replacement: 'log(' },
      { trigger: /ln$/, replacement: 'ln(' },
      { trigger: /abs$/, replacement: 'abs(' },
    ];
    for (let func of incompleteFunctions) {
      if (func.trigger.test(expr)) {
        addSuggestion(`Add brackets ${func.replacement}`, '(', false);
      }
    }

    // 3. Implicit multiplication suggestion
    // Cases: number followed by constants/functions/parenthesis (e.g. 3pi, 3π, 2(5+5))
    if (/\d(pi|π|e|sin|cos|tan|asin|acos|atan|sin⁻¹|cos⁻¹|tan⁻¹|log|ln|sqrt|cbrt|exp|\()$/.test(expr)) {
      addSuggestion(`Insert multiply ×`, '×', false);
    }
    // Case: ) followed by number or constant
    if (/\)(pi|π|e|sin|cos|tan|asin|acos|atan|sin⁻¹|cos⁻¹|tan⁻¹|log|ln|sqrt|cbrt|exp|\d|\()$/.test(expr)) {
      addSuggestion(`Insert multiply ×`, '×', false);
    }

    // Dynamic tip for inverse trig functions when typing trig functions
    if (/(sin|cos|tan)$/.test(expr)) {
      addSuggestion(`💡 Tip: Toggle "2nd" for shifted functions (∛, x³, eˣ, 10ˣ)`, '2ND_TIP', false);
    }

    // 4. Trailing operator warning or autocomplete suggestion
    if (/[+\-×÷^mod]$/.test(expr)) {
      addSuggestion(`Insert number`, '5');
      addSuggestion(`Remove operator`, 'DEL', true);
    }

    // 5. Division by zero warnings
    if (/\/\s*0+$/.test(expr)) {
      addSuggestion(`Avoid zero division`, 'DEL', true);
    }

    // 6. Beginner deterministic layout hints
    if (state.layoutMode === 'BEGINNER') {
      if (/^[0-9.]+$/.test(expr)) {
        addSuggestion(`Add basic operator (+, -, ×, ÷)`, ' + ');
      }
      if (openCount === 0 && expr.length > 2 && !/[+\-×÷^mod]$/.test(expr)) {
        addSuggestion(`Solve equation =`, '=');
      }
    }

    // Render suggestions as clickable pills
    if (suggestions.length === 0) {
      elSuggestions.innerHTML = `<span class="text-xs text-brand-success font-geist-mono flex items-center gap-1">✓ Valid syntax</span>`;
    } else {
      suggestions.forEach(s => {
        const pill = document.createElement('button');
        pill.className = "px-2.5 py-1 text-[11px] font-geist-mono font-medium rounded-full bg-canvas-soft-2 hover:bg-brand-link hover:text-canvas border border-hairline text-body cursor-pointer whitespace-nowrap transition-colors select-none flex-shrink-0 shadow-2xs";
        pill.innerHTML = s.label;
        pill.addEventListener('click', (e) => {
          e.preventDefault();
          if (s.insertionText === '=') {
            performCalculation();
          } else if (s.insertionText === 'DEL') {
            state.expression = state.expression.slice(0, -1);
            updateScreen();
          } else if (s.insertionText === '2ND_TIP') {
            state.secondActive = !state.secondActive;
            updateSecondUI();
          } else {
            state.expression += s.insertionText;
            updateScreen();
          }
        });
        elSuggestions.appendChild(pill);
      });
    }
  }

  // 5. updateScreen (depends on evaluateLive, generateSuggestions)
  function updateScreen() {
    elText.textContent = state.expression;
    // Scroll screen-input scrollable area to right
    const scrollContainer = elText.parentElement;
    if (scrollContainer) {
      scrollContainer.scrollLeft = scrollContainer.scrollWidth;
    }
    evaluateLive();
    generateSuggestions();
  }

  // 6. updateAngleUI (depends on evaluateLive)
  function updateAngleUI() {
    parser.angleMode = state.angleMode;
    elAngleIndicator.textContent = state.angleMode;
    if (state.angleMode === 'DEG') {
      btnDeg.className = "px-3 py-0.5 text-[10px] font-bold rounded-full cursor-pointer transition-all duration-150 bg-ink text-canvas shadow-xs";
      btnRad.className = "px-3 py-0.5 text-[10px] font-bold rounded-full cursor-pointer transition-all duration-150 text-body hover:text-ink";
    } else {
      btnDeg.className = "px-3 py-0.5 text-[10px] font-bold rounded-full cursor-pointer transition-all duration-150 text-body hover:text-ink";
      btnRad.className = "px-3 py-0.5 text-[10px] font-bold rounded-full cursor-pointer transition-all duration-150 bg-ink text-canvas shadow-xs";
    }
    evaluateLive();
  }

  // 6b. updateSecondUI (depends on state)
  function updateSecondUI() {
    const btnSecond = document.getElementById('btn-second');
    const sinBtn = document.getElementById('btn-trig-sin');
    const cosBtn = document.getElementById('btn-trig-cos');
    const tanBtn = document.getElementById('btn-trig-tan');
    const sqrtBtn = document.getElementById('btn-fn-sqrt');
    const sqBtn = document.getElementById('btn-fn-sq');
    const lnBtn = document.getElementById('btn-fn-ln');
    const logBtn = document.getElementById('btn-fn-log');

    if (state.secondActive) {
      if (btnSecond) {
        btnSecond.className = "px-3 py-0.5 text-[10px] font-bold rounded-full cursor-pointer transition-all duration-150 bg-ink text-canvas shadow-xs";
      }
      if (sinBtn) {
        sinBtn.textContent = "sin⁻¹";
        sinBtn.setAttribute('data-val', 'sin⁻¹(');
      }
      if (cosBtn) {
        cosBtn.textContent = "cos⁻¹";
        cosBtn.setAttribute('data-val', 'cos⁻¹(');
      }
      if (tanBtn) {
        tanBtn.textContent = "tan⁻¹";
        tanBtn.setAttribute('data-val', 'tan⁻¹(');
      }
      if (sqrtBtn) {
        sqrtBtn.textContent = "∛";
        sqrtBtn.setAttribute('data-val', '∛(');
      }
      if (sqBtn) {
        sqBtn.textContent = "x³";
        sqBtn.setAttribute('data-val', '^3');
      }
      if (lnBtn) {
        lnBtn.textContent = "eˣ";
        lnBtn.setAttribute('data-val', 'e^(');
      }
      if (logBtn) {
        logBtn.textContent = "10ˣ";
        logBtn.setAttribute('data-val', '10^(');
      }
    } else {
      if (btnSecond) {
        btnSecond.className = "px-3 py-0.5 text-[10px] font-bold rounded-full cursor-pointer transition-all duration-150 text-body hover:text-ink";
      }
      if (sinBtn) {
        sinBtn.textContent = "sin";
        sinBtn.setAttribute('data-val', 'sin(');
      }
      if (cosBtn) {
        cosBtn.textContent = "cos";
        cosBtn.setAttribute('data-val', 'cos(');
      }
      if (tanBtn) {
        tanBtn.textContent = "tan";
        tanBtn.setAttribute('data-val', 'tan(');
      }
      if (sqrtBtn) {
        sqrtBtn.textContent = "√";
        sqrtBtn.setAttribute('data-val', '√(');
      }
      if (sqBtn) {
        sqBtn.textContent = "x²";
        sqBtn.setAttribute('data-val', '^2');
      }
      if (lnBtn) {
        lnBtn.textContent = "ln";
        lnBtn.setAttribute('data-val', 'ln(');
      }
      if (logBtn) {
        logBtn.textContent = "log";
        logBtn.setAttribute('data-val', 'log(');
      }
    }
  }

  // 7. updateLayoutUI (no dependencies)
  function updateLayoutUI() {
    const secondToggleContainer = document.getElementById('second-toggle-container');
    if (state.layoutMode === 'BEGINNER') {
      keypadBeg.classList.remove('hidden');
      keypadAdv.classList.add('hidden');
      if (secondToggleContainer) secondToggleContainer.classList.add('hidden');
      btnBeg.className = "px-3 py-1 text-xs rounded-full font-medium cursor-pointer transition-all duration-150 bg-ink text-canvas shadow-xs";
      btnAdv.className = "px-3 py-1 text-xs rounded-full font-medium cursor-pointer transition-all duration-150 text-body hover:text-ink";
      elModeIndicator.textContent = "Beginner";
    } else {
      keypadBeg.classList.add('hidden');
      keypadAdv.classList.remove('hidden');
      if (secondToggleContainer) secondToggleContainer.classList.remove('hidden');
      btnBeg.className = "px-3 py-1 text-xs rounded-full font-medium cursor-pointer transition-all duration-150 text-body hover:text-ink";
      btnAdv.className = "px-3 py-1 text-xs rounded-full font-medium cursor-pointer transition-all duration-150 bg-ink text-canvas shadow-xs";
      elModeIndicator.textContent = "Advanced";
    }
    state.secondActive = false;
    updateSecondUI();
  }

  // 8. handleKeyVal (depends on updateScreen)
  function handleKeyVal(val) {
    if (val === '^2' || val === '^3') {
      state.expression += val;
    } else if (val === '10^(' || val === 'e^(') {
      state.expression += val;
    } else {
      state.expression += val;
    }

    // Auto turn off 2nd mode after a shifted value has been input
    if (state.secondActive && (val === 'sin⁻¹(' || val === 'cos⁻¹(' || val === 'tan⁻¹(' || val === '∛(' || val === '^3' || val === 'e^(' || val === '10^(')) {
      state.secondActive = false;
      updateSecondUI();
    }

    updateScreen();
  }

  // 9. handleKeyControl (depends on updateScreen, performCalculation)
  function handleKeyControl(val) {
    if (val === 'AC') {
      state.expression = "";
      elHistory.textContent = "";
      updateScreen();
    } else if (val === 'DEL') {
      // Check if delete can backspace entire function blocks
      const functionsToBack = ['sin⁻¹(', 'cos⁻¹(', 'tan⁻¹(', 'sin(', 'cos(', 'tan(', 'log(', 'ln(', 'abs(', '10^(', 'e^(', '√(', '∛(', ' mod ', 'mod'];
      let matchedFunc = false;
      for (let f of functionsToBack) {
        if (state.expression.endsWith(f)) {
          state.expression = state.expression.slice(0, -f.length);
          matchedFunc = true;
          break;
        }
      }
      if (!matchedFunc) {
        state.expression = state.expression.slice(0, -1);
      }
      updateScreen();
    } else if (val === '=') {
      performCalculation();
    }
  }

  // Switch handlers (depends on updateLayoutUI, updateAngleUI)
  btnBeg.addEventListener('click', () => {
    state.layoutMode = 'BEGINNER';
    localStorage.setItem('layoutMode', 'BEGINNER');
    updateLayoutUI();
  });
  btnAdv.addEventListener('click', () => {
    state.layoutMode = 'ADVANCED';
    localStorage.setItem('layoutMode', 'ADVANCED');
    updateLayoutUI();
  });
  btnDeg.addEventListener('click', () => {
    state.angleMode = 'DEG';
    localStorage.setItem('angleMode', 'DEG');
    updateAngleUI();
  });
  btnRad.addEventListener('click', () => {
    state.angleMode = 'RAD';
    localStorage.setItem('angleMode', 'RAD');
    updateAngleUI();
  });

  const btnSecond = document.getElementById('btn-second');
  if (btnSecond) {
    btnSecond.addEventListener('click', () => {
      state.secondActive = !state.secondActive;
      updateSecondUI();
    });
  }

  // Attach Grid Event Listeners (depends on handleKeyVal, handleKeyControl)
  document.querySelectorAll('.key-val').forEach(btn => {
    btn.addEventListener('click', () => {
      handleKeyVal(btn.getAttribute('data-val'));
    });
  });

  document.querySelectorAll('.key-control').forEach(btn => {
    btn.addEventListener('click', () => {
      handleKeyControl(btn.getAttribute('data-val'));
    });
  });

  // ─── Physical Keyboard Listening ───
  window.addEventListener('keydown', (e) => {
    // Prevent typing into other input elements if any are active
    if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') {
      return;
    }

    // Ignore keyboard shortcuts with Ctrl/Cmd/Alt modifier keys
    if (e.ctrlKey || e.altKey || e.metaKey) {
      return;
    }

    const key = e.key;

    if (key >= '0' && key <= '9') {
      handleKeyVal(key);
    } else if (key === '.') {
      handleKeyVal('.');
    } else if (key === '+') {
      handleKeyVal('+');
    } else if (key === '-') {
      handleKeyVal('-');
    } else if (key === '*') {
      handleKeyVal('×');
    } else if (key === '/') {
      handleKeyVal('÷');
    } else if (key === '^') {
      handleKeyVal('^');
    } else if (key === '(') {
      handleKeyVal('(');
    } else if (key === ')') {
      handleKeyVal(')');
    } else if (key === 'Enter' || key === '=') {
      e.preventDefault();
      performCalculation();
    } else if (key === 'Backspace' || key === 'Delete') {
      handleKeyControl('DEL');
    } else if (key === 'Escape') {
      handleKeyControl('AC');
    } else if (key === '!') {
      handleKeyVal('!');
    } else if (key.toLowerCase() === 'p') {
      handleKeyVal('π');
    } else if (key.toLowerCase() === 'e') {
      handleKeyVal('e');
    } else if (key === 'S') {
      handleKeyVal('sin⁻¹(');
    } else if (key === 'C') {
      handleKeyVal('cos⁻¹(');
    } else if (key === 'T') {
      handleKeyVal('tan⁻¹(');
    } else if (key === 's') {
      if (state.secondActive) {
        handleKeyVal('sin⁻¹(');
      } else {
        handleKeyVal('sin(');
      }
    } else if (key === 'c') {
      if (state.secondActive) {
        handleKeyVal('cos⁻¹(');
      } else {
        handleKeyVal('cos(');
      }
    } else if (key === 't') {
      if (state.secondActive) {
        handleKeyVal('tan⁻¹(');
      } else {
        handleKeyVal('tan(');
      }
    } else if (key.toLowerCase() === 'l') {
      if (state.secondActive) {
        handleKeyVal('10^(');
      } else {
        handleKeyVal('log(');
      }
    } else if (key.toLowerCase() === 'n') {
      if (state.secondActive) {
        handleKeyVal('e^(');
      } else {
        handleKeyVal('ln(');
      }
    } else if (key.toLowerCase() === 'q') {
      if (state.secondActive) {
        handleKeyVal('∛(');
      } else {
        handleKeyVal('√(');
      }
    } else if (key.toLowerCase() === 'a') {
      handleKeyVal('abs(');
    } else if (key.toLowerCase() === 'm') {
      handleKeyVal('mod');
    }
  });

  // Handle external loading from sidebar history clicking
  window.addEventListener('loadHistoryItem', (e: any) => {
    if (e.detail && e.detail.expr) {
      state.expression = e.detail.expr;
      updateScreen();
    }
  });

  // Apply initially
  updateLayoutUI();
  updateAngleUI();
</script>
