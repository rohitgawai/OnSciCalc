---
// src/components/CalculatorPage.astro
import Layout from '../layouts/Layout.astro';
import Calculator from './Calculator.astro';
import HelpDrawer from './HelpDrawer.astro';
import HistoryPanel from './HistoryPanel.astro';
import LanguagePicker from './LanguagePicker.astro';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const siteUrl = "https://onscicalc.com";
const pageUrl = lang === 'en' ? siteUrl : `${siteUrl}/${lang}`;
const privacyUrl = lang === 'en' ? `${siteUrl}/privacy-policy` : `${siteUrl}/${lang}/privacy-policy`;
const pageTitle = t('meta.home_title');
const pageDesc = t('meta.home_desc');
const pageKeywords = t('meta.home_keywords');

const calculatorQuestionTypes = [
  "Arithmetic",
  "Algebra",
  "Trigonometry",
  "Logarithmic Equation",
  "Polynomial Equation",
  "Polynomial Expression",
  "Rational Expression",
  "Function"
];

const faqQuestions = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
  { q: t('faq.q5'), a: t('faq.a5') },
  { q: t('faq.q6'), a: t('faq.a6') },
  { q: t('faq.q7'), a: t('faq.a7') },
  { q: t('faq.q8'), a: t('faq.a8') },
  { q: t('faq.q9'), a: t('faq.a9') },
];
---

<Layout title={pageTitle} description={pageDesc} keywords={pageKeywords} canonical={pageUrl} lang={lang}>
  <!-- Structured Data: Math Solver -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["MathSolver", "LearningResource"],
    "@id": `${pageUrl}/#mathsolver`,
    "name": `${t('brand.name')} ${t('meta.home_title')}`,
    "url": pageUrl,
    "description": pageDesc,
    "learningResourceType": "Math Solver",
    "inLanguage": lang,
    "usageInfo": privacyUrl,
    "potentialAction": [{
      "@type": "SolveMathAction",
      "target": `${pageUrl}/?expr={math_expression}`,
      "mathExpression-input": "required name=math_expression",
      "eduQuestionType": calculatorQuestionTypes
    }]
  })} />

  <!-- Structured Data: Software Application -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${pageUrl}/#app`,
    "name": t('brand.name'),
    "url": pageUrl,
    "description": pageDesc,
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "All",
    "inLanguage": lang,
    "image": "https://onscicalc.com/og-image.png",
    "screenshot": "https://onscicalc.com/og-image.png",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock"
    },
    "featureList": [
      "Trigonometric functions (sin, cos, tan, asin, acos, atan)",
      "Degree and Radian angle modes",
      "Logarithmic functions (log base 10, ln natural log)",
      "Fraction and mixed number arithmetic",
      "Double precision floating point calculations",
      "Calculation history with localStorage persistence",
      "AI contextual expression autocomplete suggestions",
      "Keyboard shortcuts for power users",
      "Dark and light theme support",
      "10 languages with native RTL Arabic support",
      "Progressive Web App (PWA) offline support"
    ],
    "browserRequirements": "Requires a modern web browser with JavaScript support (Chrome, Safari, Firefox, Edge)"
  })} />

  <!-- Structured Data: FAQ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${pageUrl}/#faq`,
    "mainEntity": faqQuestions.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  })} />

  <!-- Structured Data: Breadcrumbs -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": t('nav.home'),
        "item": pageUrl
      }
    ]
  })} />

  <!-- Main Page Container -->
  <div class="relative min-h-dvh flex flex-col overflow-hidden">
    
    <!-- Ambient Mesh Gradient Backdrop -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10 opacity-35 dark:opacity-20 transition-opacity duration-300">
      <div class="absolute -top-[10%] left-[20%] w-[350px] md:w-[600px] h-[350px] md:h-[600px] rounded-full bg-brand-cyan/40 blur-[80px] md:blur-[120px] animate-mesh-1"></div>
      <div class="absolute top-[30%] -left-[10%] w-[300px] md:w-[500px] h-[300px] md:h-[500px] rounded-full bg-brand-violet/30 blur-[80px] md:blur-[110px] animate-mesh-2"></div>
    </div>

    <!-- Header Navigation -->
    <header class="h-14 border-b border-hairline bg-canvas/75 backdrop-blur-md flex items-center justify-between px-4 md:px-6 lg:px-8 z-40 relative">
      <div class="flex items-center gap-4">
        <a href={translatePath('/')} class="flex items-center gap-2 no-underline">
          <svg class="w-5 h-5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 20h18L12 4z" fill="currentColor" fill-opacity="0.08"></path>
          </svg>
          <span class="text-sm font-semibold tracking-tight text-ink font-geist">OnSciCalc<span class="text-brand-link">.</span></span>
        </a>

        <!-- Tools Navigation -->
        <nav class="hidden sm:flex items-center gap-3 text-xs font-geist ml-2">
          <a href={translatePath('/tools/fraction-calculator')} class="text-body hover:text-ink transition-colors no-underline">{t('nav.fraction_calc')}</a>
          <a href={translatePath('/tools/trigonometry-calculator')} class="text-body hover:text-ink transition-colors no-underline">{t('nav.trig_calc')}</a>
          <a href={translatePath('/tools/logarithm-calculator')} class="text-body hover:text-ink transition-colors no-underline">{t('nav.log_calc')}</a>
          <a href={translatePath('/guides')} class="text-body hover:text-ink transition-colors no-underline">{t('nav.guides')}</a>
        </nav>
      </div>

      <!-- Header actions -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <!-- Language Picker Dropdown -->
        <LanguagePicker variant="header" />

        <!-- Help trigger (? button - Mobile only) -->
        <button id="trigger-help-mobile" class="lg:hidden flex items-center justify-center w-8 h-8 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft-2 text-ink text-sm font-semibold font-geist-mono shadow-2xs cursor-pointer active:scale-95 transition-transform" title={t('guide.title')}>
          ?
        </button>

        <!-- Dark/Light Theme Toggle -->
        <button id="theme-toggle-btn" class="flex items-center justify-center w-8 h-8 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft-2 text-ink shadow-2xs cursor-pointer active:scale-95 transition-transform" title={t('nav.toggle_theme')}>
          <svg id="theme-icon-sun" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg id="theme-icon-moon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 3a9 9 0 1 0 9 9 9.75 9.75 0 0 0-.92-4.59 7.75 7.75 0 0 1-8.08-8.08A9.75 9.75 0 0 0 12 3Z"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- Main Layout Shell -->
    <main class="flex-1 max-w-6xl w-full mx-auto p-4 md:p-6 lg:p-8 flex flex-col items-center justify-center lg:grid lg:grid-cols-[1fr_360px] lg:gap-8 z-10 relative">
      
      <!-- Left Column: Scientific Calculator -->
      <section class="w-full flex items-center justify-center h-full lg:h-auto">
        <Calculator lang={lang} />
      </section>

      <!-- Right Column: Sidebar (History & Guide - Hidden on Mobile/Tablet) -->
      <aside class="hidden lg:flex flex-col gap-6 h-full justify-between">
        <HistoryPanel lang={lang} />
        <HelpDrawer mode="desktop" lang={lang} />
      </aside>

    </main>

    <!-- Slide-up Drawer container for mobile -->
    <HelpDrawer mode="mobile" lang={lang} />

    <!-- SEO Content Section -->
    <div class="w-full max-w-6xl mx-auto px-4 md:px-6 lg:px-8 pb-8 z-10 relative">
      <details class="group">
        <summary class="hidden md:block cursor-pointer text-sm text-ink/50 hover:text-ink/70 transition-colors duration-200 py-3 border-t border-hairline">
          <span class="group-open:hidden">{t('seo.about_toggle')}</span>
          <span class="hidden group-open:inline">{t('seo.about_toggle_close')}</span>
        </summary>
        <div class="hidden md:block group-open:block text-sm leading-relaxed text-ink/60 space-y-4 pt-2">
          
          <h2 class="text-base font-semibold text-ink/80">{t('seo.h1')}</h2>
          <p>{t('seo.p1')}</p>

          <h3 class="text-sm font-medium text-ink/75">{t('seo.h2_why')}</h3>
          <p>{t('seo.p_why')}</p>

          <h3 class="text-sm font-medium text-ink/75">{t('seo.h2_funcs')}</h3>
          <p>{t('seo.p_funcs')}</p>

          <h3 class="text-sm font-medium text-ink/75">{t('seo.h2_eng')}</h3>
          <p>{t('seo.p_eng')}</p>

          <h3 class="text-sm font-medium text-ink/75">{t('seo.h2_features')}</h3>
          <p>{t('seo.p_features')}</p>

          <h3 class="text-sm font-medium text-ink/75">{t('seo.h2_access')}</h3>
          <p>{t('seo.p_access')}</p>

          <p class="text-xs text-ink/40 pt-2">{t('seo.footer_summary')}</p>

          <!-- FAQ Section -->
          <div class="pt-6 border-t border-hairline mt-6">
            <h2 class="text-base font-semibold text-ink/80 mb-4">{t('faq.title')}</h2>
            <div class="space-y-3">
              {faqQuestions.map(item => (
                <details class="group/faq">
                  <summary class="cursor-pointer text-sm font-medium text-ink/70 hover:text-ink/90 transition-colors duration-200 py-2">
                    {item.q}
                  </summary>
                  <p class="text-sm text-ink/55 pl-4 pb-2">
                    {item.a}
                  </p>
                </details>
              ))}
            </div>
          </div>

        </div>
      </details>
    </div>

    <!-- Footer -->
    <footer class="border-t border-hairline bg-canvas/75 backdrop-blur-md z-10 relative mt-auto">
      <div class="max-w-6xl mx-auto px-4 md:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
          <!-- Brand -->
          <div class="col-span-2 md:col-span-1">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 20h18L12 4z" fill="currentColor" fill-opacity="0.08"></path>
              </svg>
              <span class="text-sm font-semibold tracking-tight text-ink font-geist">OnSciCalc<span class="text-brand-link">.</span></span>
            </div>
            <p class="text-xs text-ink/50 leading-relaxed mb-4">{t('brand.tagline')}</p>
            
            <!-- Language selector in footer -->
            <LanguagePicker variant="footer" />
          </div>

          <!-- Quick Links -->
          <div>
            <h4 class="text-xs font-semibold text-ink/70 uppercase tracking-wider mb-3 font-geist">{t('nav.quick_links')}</h4>
            <ul class="space-y-2">
              <li><a href={translatePath('/')} class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">{t('nav.calculator')}</a></li>
              <li><a href={translatePath('/guides')} class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">{t('nav.guides')}</a></li>
              <li><a href={translatePath('/blog')} class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">{t('nav.blog')}</a></li>
              <li><a href={translatePath('/about-us')} class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">{t('nav.about')}</a></li>
              <li><a href={translatePath('/contact-us')} class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">{t('nav.contact')}</a></li>
            </ul>
          </div>

          <!-- Legal -->
          <div>
            <h4 class="text-xs font-semibold text-ink/70 uppercase tracking-wider mb-3 font-geist">{t('nav.legal')}</h4>
            <ul class="space-y-2">
              <li><a href={translatePath('/privacy-policy')} class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">{t('nav.privacy')}</a></li>
              <li><a href={translatePath('/terms-and-conditions')} class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">{t('nav.terms')}</a></li>
            </ul>
          </div>

          <!-- Connect -->
          <div>
            <h4 class="text-xs font-semibold text-ink/70 uppercase tracking-wider mb-3 font-geist">{t('nav.connect')}</h4>
            <ul class="space-y-2">
              <li><a href="mailto:contact@onscicalc.com" class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">{t('nav.email_us')}</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-2">
          <p class="text-xs text-ink/40 font-geist">&copy; {new Date().getFullYear()} OnSciCalc. {t('brand.all_rights')}</p>
          <p class="text-xs text-ink/40 font-geist">{t('brand.made_with')}</p>
        </div>
      </div>
    </footer>

  </div>
</Layout>

<script>
  // ─── Theme Toggling Script ───
  const btnTheme = document.getElementById('theme-toggle-btn');
  if (btnTheme) {
    btnTheme.addEventListener('click', (e) => {
      e.preventDefault();
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }

  // ─── Mobile Slide-up Drawer Toggling Script ───
  const btnHelp = document.getElementById('trigger-help-mobile');
  const drawerOverlay = document.getElementById('mobile-help-drawer-overlay');
  const drawerSheet = document.getElementById('mobile-help-drawer');
  const btnCloseHelp = document.getElementById('close-help-drawer');

  if (btnHelp && drawerOverlay && drawerSheet && btnCloseHelp) {
    const openDrawer = (e: Event) => {
      e.preventDefault();
      drawerOverlay.classList.remove('pointer-events-none', 'opacity-0');
      drawerSheet.classList.remove('translate-y-full');
    };

    const closeDrawer = (e: Event) => {
      e.preventDefault();
      drawerOverlay.classList.add('pointer-events-none', 'opacity-0');
      drawerSheet.classList.add('translate-y-full');
    };

    btnHelp.addEventListener('click', openDrawer);
    btnCloseHelp.addEventListener('click', closeDrawer);
    
    // Close on overlay tap
    drawerOverlay.addEventListener('click', (e) => {
      if (e.target === drawerOverlay) {
        drawerOverlay.classList.add('pointer-events-none', 'opacity-0');
        drawerSheet.classList.add('translate-y-full');
      }
    });
  }
</script>
