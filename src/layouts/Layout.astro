---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
}

const { 
  title = "Online Scientific Calculator - Free Scientific Calculator | OnSciCalc", 
  description = "Use OnSciCalc - the best free online scientific calculator for engineering, students, and professionals. Supports sin cos tan, fractions, logarithms, exponents, and complex math functions. No download required.",
  keywords = "online scientific calculator, scientific calculator, desmos scientific calculator, free online scientific calculator, best online scientific calculator, online scientific calculator casio, calculator, sin cos tan calculator, scientific calc, online scientific calculator for engineering, online scientific calculator fx-991es, online scientific calculator with fraction, online scientific calculator texas instruments, casio scientific calculator",
  canonical = "https://onscicalc.com/",
  ogImage = "https://onscicalc.com/og-image.png"
} = Astro.props;

const siteName = "OnSciCalc";
const siteUrl = "https://onscicalc.com";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="OnSciCalc" />
		<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="OnSciCalc - Free Online Scientific Calculator" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonical} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />
		<meta property="twitter:image:alt" content="OnSciCalc - Free Online Scientific Calculator" />

		<!-- Additional SEO Meta -->
		<meta name="application-name" content={siteName} />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content={siteName} />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

		<!-- Prefetch and load Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" rel="stylesheet" />

		<!-- Blocking Script to Apply Theme immediately -->
		<script is:inline>
			(function() {
				const storedTheme = localStorage.getItem('theme');
				if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>

		<!-- Structured Data for Software Application -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebApplication",
			"name": "OnSciCalc",
			"url": siteUrl,
			"description": description,
			"applicationCategory": "UtilityApplication",
			"operatingSystem": "Web Browser",
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			},
			"featureList": [
				"Scientific functions (sin, cos, tan, log, ln)",
				"Fraction calculations",
				"Engineering mode",
				"History tracking",
				"Dark/Light theme",
				"Keyboard shortcuts"
			],
			"browserRequirements": "Requires a modern web browser with JavaScript support"
		})} />

		<!-- Structured Data for FAQ -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "FAQPage",
			"mainEntity": [
				{
					"@type": "Question",
					"name": "What is the best scientific calculator online?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "OnSciCalc is widely considered the best scientific calculator online. It offers a comprehensive set of scientific functions including sin, cos, tan, logarithms, exponents, fractions, and factorial operations. It runs entirely in your browser with no downloads required, works on all devices, and is completely free to use."
					}
				},
				{
					"@type": "Question",
					"name": "What is the best online scientific calculator?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "The best online scientific calculator is one that combines accuracy, speed, and ease of use. OnSciCalc stands out as the top choice because it provides instant calculations, supports both beginner and advanced modes, includes keyboard shortcuts, expression history, and works seamlessly across desktop, tablet, and mobile browsers."
					}
				},
				{
					"@type": "Question",
					"name": "How to use online scientific calculator?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Using OnSciCalc is simple: visit the website and start typing your mathematical expression directly. Use the on-screen buttons or your keyboard to input numbers and operations. The calculator provides live previews of your result as you type. Switch between Beginner and Advanced modes depending on your needs, and toggle between degrees and radians for trigonometric functions."
					}
				},
				{
					"@type": "Question",
					"name": "What is a virtual scientific calculator?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "A virtual scientific calculator is a software-based calculator that runs on your device screen, replacing the need for a physical calculator. OnSciCalc is a virtual scientific calculator that works in any modern web browser, offering all the functions of a traditional scientific calculator like the Casio fx-991es or Texas Instruments models, without requiring any hardware purchase."
					}
				},
				{
					"@type": "Question",
					"name": "What is a good scientific calculator app?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "OnSciCalc serves as an excellent alternative to traditional scientific calculator apps. Since it runs in your browser, there is nothing to download or install. Simply bookmark the page and access it anytime from any device. It offers the same features as popular calculator apps including trigonometric functions, logarithms, fractions, and engineering calculations."
					}
				},
				{
					"@type": "Question",
					"name": "Is there a scientific calculator with AI?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "Yes, OnSciCalc features AI-powered suggestions that help you build expressions correctly. As you type, the calculator provides intelligent suggestions for completing your mathematical expressions, reducing syntax errors and speeding up your workflow. This makes it easier for students and professionals to work with complex calculations."
					}
				},
				{
					"@type": "Question",
					"name": "How to use scientific calculator?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "To use OnSciCalc, simply type your mathematical expression using the number pad, operators, and function buttons. For trigonometric functions, select whether you are working in degrees or radians using the RAD/DEG toggle. Use parentheses for grouping, and the calculator will evaluate your expression in standard algebraic order. Access the help guide by clicking the ? button for detailed instructions."
					}
				},
				{
					"@type": "Question",
					"name": "What is abs in a scientific calculator?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "The abs function on a scientific calculator computes the absolute value of a number, which is the non-negative value of any number regardless of its sign. For example, abs(-5) returns 5, and abs(5) returns 5. OnSciCalc supports the abs function and you can access it by typing 'abs' followed by the number in parentheses, such as abs(-3.14)."
					}
				},
				{
					"@type": "Question",
					"name": "How to write love in a calculator?",
					"acceptedAnswer": {
						"@type": "Answer",
						"text": "You can write fun words on a scientific calculator by typing numbers and flipping the screen upside down. Each digit resembles a letter when inverted: 0=O, 1=I, 3=E, 4=h, 5=S, 6=g, 7=L, 8=B, 9=G. Try these: 0.7734 reads 'hELLO', 0.1134 reads 'hELL', 35007 reads 'LOLE', 7718 reads 'BEEL', and 0.7734371 reads 'I LLEhELLO' — a creative 'I love you' approximation! This classic trick is a fun way to explore calculator displays."
					}
				}
			]
		})} />
	</head>
	<body class="bg-canvas-soft text-ink select-none antialiased">
		<slot />
	</body>
</html>
