---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
}

const { 
  title = "Online Scientific Calculator | OnSciCalc", 
  description = "A free online scientific calculator with full screen mode, double-digit precision, and support for fractions, trigonometry, logarithms, and exponential functions. Works via button click or keyboard.",
  keywords = "online scientific calculator, scientific calculator free, fraction calculator, trigonometry calculator, log calculator, engineering calculator",
  canonical = "https://onscicalc.com/",
  ogImage = "https://onscicalc.com/og-image.png",
  robots = "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
} = Astro.props;

const siteName = "OnSciCalc";
const siteUrl = "https://onscicalc.com";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- Google tag (gtag.js) - Deferred for performance -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-RV6CL7DBF8"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-RV6CL7DBF8', { 'send_page_view': true });
		</script>

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="OnSciCalc" />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="OnSciCalc - Free Online Scientific Calculator" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonical} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />
		<meta property="twitter:image:alt" content="OnSciCalc - Free Online Scientific Calculator" />

		<!-- Additional SEO Meta -->
		<meta name="application-name" content={siteName} />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content={siteName} />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

		<!-- Prefetch and load Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" rel="stylesheet" />

		<!-- Blocking Script to Apply Theme immediately -->
		<script is:inline>
			(function() {
				const storedTheme = localStorage.getItem('theme');
				if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			})();
		</script>

		<!-- Service Worker Registration for PWA Offline Caching -->
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(() => {});
				});
			}
		</script>
	</head>
	<body class="bg-canvas-soft text-ink select-none antialiased">
		<slot />
	</body>
</html>
