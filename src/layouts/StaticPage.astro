---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
}

const { title, description, canonical } = Astro.props;
const siteUrl = "https://onscicalc.com";
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="min-h-dvh flex flex-col bg-canvas-soft">

    <!-- Header -->
    <header class="h-14 border-b border-hairline bg-canvas/75 backdrop-blur-md flex items-center justify-between px-4 md:px-6 lg:px-8 z-40 relative">
      <a href="/" class="flex items-center gap-2 no-underline">
        <svg class="w-5 h-5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 20h18L12 4z" fill="currentColor" fill-opacity="0.08"></path>
        </svg>
        <span class="text-sm font-semibold tracking-tight text-ink font-geist">OnSciCalc<span class="text-brand-link">.</span></span>
      </a>
      <div class="flex items-center gap-4">
        <a href="/" class="text-sm text-ink/60 hover:text-ink transition-colors font-geist hidden sm:inline">Home</a>
        <a href="/about-us" class="text-sm text-ink/60 hover:text-ink transition-colors font-geist hidden sm:inline">About</a>
        <a href="/contact-us" class="text-sm text-ink/60 hover:text-ink transition-colors font-geist hidden sm:inline">Contact</a>
        <button id="theme-toggle-btn-static" class="flex items-center justify-center w-8 h-8 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft-2 text-ink shadow-2xs cursor-pointer active:scale-95 transition-transform" title="Toggle Theme">
          <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 3a9 9 0 1 0 9 9 9.75 9.75 0 0 0-.92-4.59 7.75 7.75 0 0 1-8.08-8.08A9.75 9.75 0 0 0 12 3Z"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- Mobile nav drawer trigger -->
    <div class="sm:hidden px-4 py-2 border-b border-hairline bg-canvas/50">
      <details class="group">
        <summary class="cursor-pointer text-sm text-ink/60 hover:text-ink transition-colors font-geist select-none">
          <span class="group-open:hidden">Menu &#9662;</span>
          <span class="hidden group-open:inline">Close &#9652;</span>
        </summary>
        <nav class="flex flex-col gap-1 pt-2 pb-1">
          <a href="/" class="text-sm text-ink/70 hover:text-ink transition-colors font-geist py-1.5 no-underline">Home</a>
          <a href="/about-us" class="text-sm text-ink/70 hover:text-ink transition-colors font-geist py-1.5 no-underline">About Us</a>
          <a href="/privacy-policy" class="text-sm text-ink/70 hover:text-ink transition-colors font-geist py-1.5 no-underline">Privacy Policy</a>
          <a href="/terms-and-conditions" class="text-sm text-ink/70 hover:text-ink transition-colors font-geist py-1.5 no-underline">Terms &amp; Conditions</a>
          <a href="/contact-us" class="text-sm text-ink/70 hover:text-ink transition-colors font-geist py-1.5 no-underline">Contact Us</a>
        </nav>
      </details>
    </div>

    <!-- Main Content -->
    <main class="flex-1 w-full max-w-4xl mx-auto px-4 md:px-6 lg:px-8 py-8 md:py-12 z-10 relative">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-hairline bg-canvas/75 backdrop-blur-md z-10 relative">
      <div class="max-w-4xl mx-auto px-4 md:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
          <!-- Brand -->
          <div class="col-span-2 md:col-span-1">
            <a href="/" class="flex items-center gap-2 no-underline mb-3">
              <svg class="w-4 h-4 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 20h18L12 4z" fill="currentColor" fill-opacity="0.08"></path>
              </svg>
              <span class="text-sm font-semibold tracking-tight text-ink font-geist">OnSciCalc<span class="text-brand-link">.</span></span>
            </a>
            <p class="text-xs text-ink/50 leading-relaxed">Free online scientific calculator for students, engineers, and professionals.</p>
          </div>

          <!-- Quick Links -->
          <div>
            <h4 class="text-xs font-semibold text-ink/70 uppercase tracking-wider mb-3 font-geist">Quick Links</h4>
            <ul class="space-y-2">
              <li><a href="/" class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">Calculator</a></li>
              <li><a href="/about-us" class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">About Us</a></li>
              <li><a href="/contact-us" class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">Contact Us</a></li>
            </ul>
          </div>

          <!-- Legal -->
          <div>
            <h4 class="text-xs font-semibold text-ink/70 uppercase tracking-wider mb-3 font-geist">Legal</h4>
            <ul class="space-y-2">
              <li><a href="/privacy-policy" class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">Privacy Policy</a></li>
              <li><a href="/terms-and-conditions" class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">Terms &amp; Conditions</a></li>
            </ul>
          </div>

          <!-- Connect -->
          <div>
            <h4 class="text-xs font-semibold text-ink/70 uppercase tracking-wider mb-3 font-geist">Connect</h4>
            <ul class="space-y-2">
              <li><a href="mailto:contact@onscicalc.com" class="text-sm text-ink/50 hover:text-ink transition-colors no-underline">Email Us</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-2">
          <p class="text-xs text-ink/40 font-geist">&copy; {new Date().getFullYear()} OnSciCalc. All rights reserved.</p>
          <p class="text-xs text-ink/40 font-geist">Made with precision.</p>
        </div>
      </div>
    </footer>

  </div>
</Layout>

<script>
  const btnTheme = document.getElementById('theme-toggle-btn-static');
  if (btnTheme) {
    btnTheme.addEventListener('click', (e) => {
      e.preventDefault();
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }
</script>
